# Core
APP_ENV=development  # set to production for live deployments
JWT_SECRET=  # REQUIRED: 32+ random bytes (openssl rand -hex 32)
ALLOWED_ORIGINS=  # comma-separated app origins; empty = dev wildcard
SIGNING_SECRET=  # REQUIRED: shared by Rust security service (openssl rand -hex 32)
AUTHN_SECRET=  # REQUIRED: bearer for the Rust authn core (argon2id/JWT/TOTP/OTP)
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=  # REQUIRED: do not use a repository or default password
POSTGRES_DB=chatapp

# Public client URLs (baked into web/desktop builds; used by android/ios config)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MEDIA_URL=http://localhost:8100
DATABASE_URL=  # required for a direct API run; Compose builds it from POSTGRES_* below
MONGO_URL=mongodb://localhost:27017/chatapp
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=  # optional provider credential
S3_SECRET_KEY=  # optional provider credential
S3_BUCKET=chatapp-media

# Service ports
API_PORT=8080
SECURITY_PORT=8090
MEDIA_PORT=8100
ML_PORT=8200
TRANSLATE_MODEL=
WEB_PORT=3000

# Provider integrations (fill in to activate real providers)
# Phone OTP is fully self-built (services/api/otp.go) — no Twilio dependency;
# SMTP below is the optional carrier-gateway hook for code delivery.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth (Google Identity Services) - create at console.cloud.google.com
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# WebAuthn / passkeys (must match the public origin in production)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ChatApp
WEBAUTHN_ORIGINS=http://localhost:3000

# Cluster engine (multi-node global expansion)
CLUSTER_NODE_ID=
CLUSTER_REGION=us-east
CLUSTER_API_URL=
CLUSTER_MEDIA_URL=
CLUSTER_SECRET=  # REQUIRED: shared internal bearer (openssl rand -hex 32)
COUNTERS_SECRET=  # REQUIRED: control-plane bearer for the C++ counters engine (openssl rand -hex 32)

# C++ realtime relay (WebSocket fanout edge)
REALTIME_RELAY_URL=http://localhost:8301
REALTIME_WS_PORT=8300

# SFU (self-built meetings/group calls/live broadcast + embedded STUN/TURN)
SFU_SECRET=  # REQUIRED: HMAC key for room tickets (openssl rand -hex 32)
TURN_SECRET=  # REQUIRED: HMAC key for short-lived TURN credentials (openssl rand -hex 32)
SFU_PUBLIC_URL=ws://localhost:8095/ws
SFU_HOST=localhost

# Push notifications (optional — in-app + WS notifications work without these)
VAPID_SUBJECT=  # optional; set to a real contact URI when push is configured
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY=

# Finance plane (multi-chain deposits/withdrawals, P2P, convert)
WALLET_MASTER_SEED=  # REQUIRED: 32+ random bytes (openssl rand -hex 32)
WITHDRAW_SIGNING_KEY=  # REQUIRED in production: separate 32+ random signing key (openssl rand -hex 32);
                       # non-production derives it from WALLET_MASTER_SEED when unset
WITHDRAW_AUTO_LIMIT_USD=10000   # USD amount above which risk score forces manual review
WITHDRAW_AUTO_THRESHOLD=100     # risk-score ceiling for sub-second auto-approval

# Test-only: multiplies the auth rate-limit ceilings (login, register, OTP
# send/check, recovery, reset, oauth, qr, guest). Leave UNSET in production so
# the hardened defaults apply unchanged; the E2E harness sets e.g. 200 so many
# accounts can be exercised back to back. Values below 1 are ignored.
RATE_LIMIT_SCALE=
