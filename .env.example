# Core
APP_ENV=development  # set to production for live deployments
JWT_SECRET=  # REQUIRED in production: 32+ random bytes (openssl rand -hex 32)
ALLOWED_ORIGINS=  # comma-separated app origins; empty = dev wildcard
SIGNING_SECRET=  # REQUIRED in production: shared by Rust security service (openssl rand -hex 32)
DATABASE_URL=postgres://chatapp:chatapp@localhost:5432/chatapp?sslmode=disable
MONGO_URL=mongodb://localhost:27017/chatapp
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chatapp-media

# Service ports
API_PORT=8080
SECURITY_PORT=8090
MEDIA_PORT=8100
ML_PORT=8200
WEB_PORT=3000

# Provider integrations (fill in to activate real providers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth (Google Identity Services) - create at console.cloud.google.com
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# WebAuthn / passkeys (must match the public origin in production)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ChatApp
WEBAUTHN_ORIGINS=http://localhost:3000

# Cluster engine (multi-node global expansion)
CLUSTER_NODE_ID=
CLUSTER_REGION=us-east
CLUSTER_API_URL=
CLUSTER_MEDIA_URL=
CLUSTER_SECRET=
