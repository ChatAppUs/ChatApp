{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatApp",
  "version": "0.1.0",
  "identifier": "dev.chatapp.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatApp",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 600,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": "default-src 'self' https: wss: data: blob:; media-src 'self' https: blob: mediastream:; connect-src 'self' https: wss: http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "ChatApp — social, chat, calls, wallet",
    "longDescription": "ChatApp desktop client: social feed, realtime chat, audio/video calls, multi-chain wallet.",
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] }
    }
  }
}
