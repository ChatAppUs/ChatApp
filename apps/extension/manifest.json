{
  "manifest_version": 3,
  "name": "ChatApp",
  "version": "1.0.0",
  "description": "ChatApp — social, messaging, calls, wallet and creator platform. Full app in your browser toolbar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatApp"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
